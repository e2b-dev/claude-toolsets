// markdownlint config, read by `pnpm lint:md` / `pnpm fmt:md` and the markdownlint editor extension.
{
  "config": {
    // Prose is soft-wrapped; tables and links make hard wrapping impractical.
    "MD013": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    // uv's Python environment: third-party package docs.
    "**/.venv/**",
    // Local only, gitignored.
    "docs/raw/**",
    "experimental/**",
    "results/**",
    // Generated by `pnpm changeset` and `changeset version`; their shape is the tool's, not ours.
    ".changeset/*.md",
    "**/CHANGELOG.md",
  ],
}
