{
  "name": "@e2b/claude-toolsets",
  "version": "0.0.1",
  "description": "E2B drivers for the browser and computer use toolsets in the Claude SDKs",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e2b-dev/claude-toolsets.git",
    "directory": "packages/claude-toolsets-js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "claude-toolsets-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/generated && cp src/generated/runtime.js src/generated/manifest.json src/generated/THIRD_PARTY_LICENSES.txt dist/generated/",
    "prepack": "pnpm build",
    "test": "bun test tests/*.test.ts",
    "exercise": "bun --env-file=../../.env tests/exercise.ts",
    "exercise:detach": "bun --env-file=../../.env tests/detach.ts",
    "exercise:lifecycle": "bun --env-file=../../.env tests/lifecycle.ts",
    "exercise:cancel": "bun --env-file=../../.env tests/cancel.ts",
    "exercise:computer": "bun --env-file=../../.env tests/computer.ts",
    "exercise:headless": "bun --env-file=../../.env tests/headless.ts",
    "exercise:security": "bun --env-file=../../.env tests/security.ts",
    "test:live": "bun --env-file=../../.env tests/live/model.ts",
    "test:live:computer": "bun --env-file=../../.env tests/live/computer.ts"
  },
  "dependencies": {
    "@e2b/desktop": "^2.4.0",
    "e2b": "^2.51.0",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.132.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.0.0",
    "@types/ws": "8.18.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  }
}
